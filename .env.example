# Copy to .env. Process environment variables take priority over this file.
MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
# none | low | medium | high | max | provider (no override). auto is an alias for low.
MODEL_REASONING=low
# Optional separate model for image inspection (profile image_mode: fallback).
# VISUAL_MODEL=
# VISUAL_BASE_URL=
# VISUAL_API_KEY=
VISUAL_REASONING=low
# Upper bound of one model response, reasoning included (max_completion_tokens).
MAX_OUTPUT_TOKENS=16384

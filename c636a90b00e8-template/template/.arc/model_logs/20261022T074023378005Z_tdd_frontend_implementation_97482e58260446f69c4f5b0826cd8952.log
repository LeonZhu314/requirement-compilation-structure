       void NavigateToHome({});\n          }}\n          className=\"text-[#2f74c0] hover:underline\"\n        >\n          HOME\n        </a>{\" \"}\n        <span aria-hidden=\"true\">&gt;</span>{\" \"}\n        <span data-ui-id=\"UI_000063\">Create an account</span>\n      </div>\n    </div>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/RegistrationCard.tsx","content":"import { RegistrationForm, type RegistrationFormProps } from \"./RegistrationForm\";\n\nexport type RegistrationCardState = {  };\nexport type RegistrationCardProps = RegistrationFormProps;\n\nexport function RegistrationCard(props: RegistrationCardProps) {\n  return (\n    <section\n      data-ui-id=\"UI_000064\"\n      className=\"mx-auto mt-4 w-full max-w-[1000px] border border-gray-200 bg-white px-5 py-9 shadow-[0_1px_3px_rgba(15,23,42,0.06)] sm:px-10\"\n    >\n      <RegistrationForm {...props} />\n    </section>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/RegistrationFooter.tsx","content":"export type RegistrationFooterState = {  };\nexport type RegistrationFooterProps = {};\n\nexport function RegistrationFooter(_props: RegistrationFooterProps) {\n  return (\n    <footer\n      data-ui-id=\"UI_000111\"\n      className=\"mt-10 w-full border-t border-gray-200 bg-[#f5f5f5] py-7 text-center text-[12px] leading-6 text-gray-500\"\n    >\n      <div className=\"mx-auto w-full max-w-[1200px] px-4\">\n        <p data-ui-id=\"UI_000112\">\n          COPYRIGHT©2008-2025 CHINA ACADEMY OF RAILWAY SCIENCES CORPORATION LIMITED, ALL RIGHTS RESERVED.\n        </p>\n        <p data-ui-id=\"UI_000113\">\n          京公网安备 11010802038392号 | 京ICP备05020493号-4 | ICP证：京B2-20202537.\n        </p>\n        <div\n          data-ui-id=\"UI_000114\"\n          className=\"mt-1 flex flex-wrap items-center justify-center gap-x-2 gap-y-1\"\n        >\n          <a data-ui-id=\"UI_000115\" href=\"#\" className=\"transition-colors hover:text-[#2f74c0]\">\n            Privacy Policy\n          </a>\n          <span aria-hidden=\"true\" className=\"text-gray-300\">\n            |\n          </span>\n          <a data-ui-id=\"UI_000116\" href=\"#\" className=\"transition-colors hover:text-[#2f74c0]\">\n            Cookie Statement\n          </a>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/RegistrationForm.tsx","content":"export type RegistrationFormValues = {\n  nationality: string;\n  name: string;\n  passport_number: string;\n  passport_expiration_date: string;\n  date_of_birth: string;\n  gender: string;\n  username: string;\n  password: string;\n  confirm_password: string;\n  email: string;\n  agreed_to_terms: boolean;\n};\n\nexport type RegistrationFormState = {  };\nexport type RegistrationFormProps = {\n  values: RegistrationFormValues;\n  errorMessage: string | null;\n  submitting: boolean;\n  onChange: (field: keyof RegistrationFormValues, value: string | boolean) => void;\n  onSubmit: () => void;\n};\n\nconst inputClass =\n  \"h-9 w-full rounded-[3px] border border-gray-300 bg-white px-3 text-sm text-gray-900 outline-none placeholder:text-gray-400 focus:border-[#2f74c0] focus:ring-1 focus:ring-[#2f74c0]/30\";\nconst labelClass = \"w-[190px] shrink-0 pt-2 text-right text-sm text-gray-700\";\nconst helperClass = \"pt-2 text-[12px] leading-5\";\n\nfunction RequiredMark() {\n  return (\n    <span aria-hidden=\"true\" className=\"mr-0.5 text-[#c62430]\">\n      *\n    </span>\n  );\n}\n\nfunction CalendarIcon() {\n  return (\n    <svg viewBox=\"0 0 20 20\" className=\"h-4 w-4\" fill=\"none\" aria-hidden=\"true\">\n      <rect x=\"3.2\" y=\"4.4\" width=\"13.6\" height=\"12.2\" rx=\"1.6\" stroke=\"currentColor\" strokeWidth=\"1.3\" />\n      <path d=\"M3.4 7.8h13.2M6.8 2.9v3M13.2 2.9v3\" stroke=\"currentColor\" strokeWidth=\"1.3\" strokeLinecap=\"round\" />\n    </svg>\n  );\n}\n\ntype DateFieldProps = {\n  id: string;\n  uiId: string;\n  buttonUiId: string;\n  buttonLabel: string;\n  value: string;\n  onChange: (value: string) => void;\n};\n\nfunction DateField({ id, uiId, buttonUiId, buttonLabel, value, onChange }: DateFieldProps) {\n  return (\n    <div className=\"relative w-[365px]\">\n      <input\n        id={id}\n        data-ui-id={uiId}\n        type=\"text\"\n        inputMode=\"numeric\"\n        autoComplete=\"off\"\n        placeholder=\"yyyy-mm-dd\"\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n        className={`${inputClass} pr-10`}\n      />\n      <button\n        type=\"button\"\n        data-ui-id={buttonUiId}\n        aria-label={buttonLabel}\n        onClick={() => document.getElementById(id)?.focus()}\n        className=\"absolute right-0 top-0 flex h-9 w-9 items-center justify-center text-gray-500 transition-colors hover:text-[#2f74c0]\"\n      >\n        <CalendarIcon />\n      </button>\n    </div>\n  );\n}\n\nexport function RegistrationForm({\n  values,\n  errorMessage,\n  submitting,\n  onChange,\n  onSubmit,\n}: RegistrationFormProps) {\n  const handleSubmit = (event: React.FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    onSubmit();\n  };\n\n  return (\n    <form data-ui-id=\"UI_000065\" noValidate onSubmit={handleSubmit} className=\"w-full\">\n      <div className=\"flex flex-col gap-5\">\n        {/* Nationality */}\n        <div data-ui-id=\"UI_000066\" className=\"flex flex-wrap items-start gap-4\">\n          <label htmlFor=\"reg-nationality\" className={labelClass}>\n            <RequiredMark />\n            <span>Nationality</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <select\n              id=\"reg-nationality\"\n              data-ui-id=\"UI_000068\"\n              value={values.nationality}\n              onChange={(event) => onChange(\"nationality\", event.target.value)}\n              className={`${inputClass} appearance-none bg-[linear-gradient(45deg,transparent_50%,#6b7280_50%),linear-gradient(135deg,#6b7280_50%,transparent_50%)] bg-[length:5px_5px,5px_5px] bg-[position:calc(100%-16px)_center,calc(100%-11px)_center] bg-no-repeat pr-9`}\n            >\n              <option data-ui-id=\"UI_000070\" value=\"\">\n                Please select\n              </option>\n              <option data-ui-id=\"UI_000069\" value=\"Vietnam\">\n                Vietnam\n              </option>\n            </select>\n          </div>\n          <p className={`${helperClass} text-[#d9820a]`}>\n            At present, only foreign passports are accepted for registration.\n          </p>\n        </div>\n\n        {/* Name */}\n        <div className=\"flex flex-wrap items-start gap-4\">\n          <label htmlFor=\"reg-name\" className={labelClass}>\n            <RequiredMark />\n            <span>Name</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-name\"\n              data-ui-id=\"UI_000073\"\n              type=\"text\"\n              autoComplete=\"off\"\n              value={values.name}\n              onChange={(event) => onChange(\"name\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n          <a\n            data-ui-id=\"UI_000074\"\n            href=\"#\"\n            className={`${helperClass} text-[#2f74c0] underline hover:text-[#255f9e]`}\n          >\n            Check the rules for filling out passport information\n          </a>\n        </div>\n\n        {/* Passport number */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-passport-number\" className={labelClass}>\n            <RequiredMark />\n            <span>Passport number</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-passport-number\"\n              data-ui-id=\"UI_000077\"\n              type=\"text\"\n              autoComplete=\"off\"\n              value={values.passport_number}\n              onChange={(event) => onChange(\"passport_number\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n        </div>\n\n        {/* Passport expiration date */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-passport-expiration\" className={labelClass}>\n            <RequiredMark />\n            <span>Passport expiration date</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <DateField\n            id=\"reg-passport-expiration\"\n            uiId=\"UI_000080\"\n            buttonUiId=\"UI_000081\"\n            buttonLabel=\"Choose passport expiration date\"\n            value={values.passport_expiration_date}\n            onChange={(value) => onChange(\"passport_expiration_date\", value)}\n          />\n        </div>\n\n        {/* Date of birth */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-date-of-birth\" className={labelClass}>\n            <RequiredMark />\n            <span>Date of birth</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <DateField\n            id=\"reg-date-of-birth\"\n            uiId=\"UI_000084\"\n            buttonUiId=\"UI_000085\"\n            buttonLabel=\"Choose date of birth\"\n            value={values.date_of_birth}\n            onChange={(value) => onChange(\"date_of_birth\", value)}\n          />\n        </div>\n\n        {/* Gender */}\n        <div className=\"flex items-start gap-4\">\n          <span id=\"reg-gender-label\" className={labelClass}>\n            <RequiredMark />\n            <span>Gender</span>\n            <span aria-hidden=\"true\">:</span>\n          </span>\n          <div\n            role=\"radiogroup\"\n            aria-labelledby=\"reg-gender-label\"\n            data-ui-id=\"UI_000088\"\n            className=\"flex w-[365px] gap-3\"\n          >\n            <label className=\"flex flex-1 cursor-pointer items-center gap-2 rounded-[3px] border border-gray-300 bg-[#fafafa] px-3 py-2 text-sm text-gray-700\">\n              <input\n                data-ui-id=\"UI_000089\"\n                type=\"radio\"\n                name=\"gender\"\n                value=\"Male\"\n                checked={values.gender === \"Male\"}\n                onChange={() => onChange(\"gender\", \"Male\")}\n                className=\"h-4 w-4\"\n              />\n              Male\n            </label>\n            <label className=\"flex flex-1 cursor-pointer items-center gap-2 rounded-[3px] border border-gray-300 bg-[#fafafa] px-3 py-2 text-sm text-gray-700\">\n              <input\n                data-ui-id=\"UI_000090\"\n                type=\"radio\"\n                name=\"gender\"\n                value=\"Female\"\n                checked={values.gender === \"Female\"}\n                onChange={() => onChange(\"gender\", \"Female\")}\n                className=\"h-4 w-4\"\n              />\n              Female\n            </label>\n          </div>\n        </div>\n\n        {/* Username */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-username\" className={labelClass}>\n            <RequiredMark />\n            <span>Username</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-username\"\n              data-ui-id=\"UI_000093\"\n              type=\"text\"\n              autoComplete=\"username\"\n              value={values.username}\n              onChange={(event) => onChange(\"username\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n        </div>\n\n        {/* Password */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-password\" className={labelClass}>\n            <RequiredMark />\n            <span>Password</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-password\"\n              data-ui-id=\"UI_000096\"\n              type=\"password\"\n              autoComplete=\"new-password\"\n              value={values.password}\n              onChange={(event) => onChange(\"password\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n        </div>\n\n        {/* Confirm Password */}\n        <div className=\"flex items-start gap-4\">\n          <label htmlFor=\"reg-confirm-password\" className={labelClass}>\n            <RequiredMark />\n            <span>Confirm Password</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-confirm-password\"\n              data-ui-id=\"UI_000099\"\n              type=\"password\"\n              autoComplete=\"new-password\"\n              value={values.confirm_password}\n              onChange={(event) => onChange(\"confirm_password\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n        </div>\n\n        {/* Email address */}\n        <div className=\"flex flex-wrap items-start gap-4\">\n          <label htmlFor=\"reg-email\" className={labelClass}>\n            <RequiredMark />\n            <span>Email address</span>\n            <span aria-hidden=\"true\">:</span>\n          </label>\n          <div className=\"w-[365px]\">\n            <input\n              id=\"reg-email\"\n              data-ui-id=\"UI_000102\"\n              type=\"text\"\n              autoComplete=\"email\"\n              value={values.email}\n              onChange={(event) => onChange(\"email\", event.target.value)}\n              className={inputClass}\n            />\n          </div>\n          <p className={`${helperClass} text-[#d9820a]`}>\n            Related notifications will be sent to you via email.\n          </p>\n        </div>\n      </div>\n\n      {/* Consent */}\n      <div className=\"mt-8 flex justify-center\">\n        <div className=\"flex w-full max-w-[660px] items-start gap-2 text-[13px] leading-5 text-gray-700\">\n          <input\n            id=\"reg-agreement\"\n            data-ui-id=\"UI_000105\"\n            type=\"checkbox\"\n            checked={values.agreed_to_terms}\n            onChange={(event) => onChange(\"agreed_to_terms\", event.target.checked)}\n            className=\"mt-0.5 h-4 w-4 shrink-0 rounded-sm border border-gray-400\"\n          />\n          <label data-ui-id=\"UI_000106\" htmlFor=\"reg-agreement\" className=\"cursor-pointer\">\n            I have read and agree to abide by{\" \"}\n            <a data-ui-id=\"UI_000107\" href=\"#\" className=\"text-[#2f74c0] underline hover:text-[#255f9e]\">\n              Terms of Service\n            </a>{\" \"}\n            and{\" \"}\n            <a data-ui-id=\"UI_000108\" href=\"#\" className=\"text-[#2f74c0] underline hover:text-[#255f9e]\">\n              Privacy Policy\n            </a>{\" \"}\n            of 12306.cn.\n          </label>\n        </div>\n      </div>\n\n      {errorMessage ? (\n        <div\n          role=\"alert\"\n          data-ui-id=\"UI_000109\"\n          className=\"mx-auto mt-5 max-w-[660px] rounded-[3px] border border-[#f0c2c2] bg-[#fdf3f3] px-4 py-2 text-[13px] text-[#c0392b]\"\n        >\n          {errorMessage}\n        </div>\n      ) : null}\n\n      <div className=\"mt-6 flex justify-center\">\n        <button\n          data-ui-id=\"UI_000110\"\n          type=\"submit\"\n          disabled={submitting}\n          className=\"h-10 w-[280px] rounded-[3px] bg-[#f08300] text-[15px] font-medium text-white transition-colors hover:bg-[#d97400] disabled:cursor-not-allowed disabled:opacity-70\"\n        >\n          Next step\n        </button>\n      </div>\n    </form>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/pages/Registration.tsx","content":"import { useState } from \"react\";\nimport { RegistrationHeader } from \"../components/RegistrationHeader\";\nimport { RegistrationPrimaryNavigation } from \"../components/RegistrationPrimaryNavigation\";\nimport { BreadcrumbRegion } from \"../components/BreadcrumbRegion\";\nimport { RegistrationCard } from \"../components/RegistrationCard\";\nimport { RegistrationFooter } from \"../components/RegistrationFooter\";\nimport { SubmitRegistration } from \"../handlers/SubmitRegistration\";\nimport type { RegistrationFormValues } from \"../components/RegistrationForm\";\n\nexport type RegistrationState = { \"nationality\": string; \"name\": string; \"passport_number\": string; \"passport_expiration_date\": string; \"date_of_birth\": string; \"gender\": string; \"username\": string; \"password\": string; \"confirm_password\": string; \"email\": string; \"agreed_to_terms\": boolean; \"registration_error_message\": (string | null); \"registration_submitting\": boolean; };\nexport type RegistrationProps = {};\n\nconst initialValues: RegistrationFormValues = {\n  nationality: \"\",\n  name: \"\",\n  passport_number: \"\",\n  passport_expiration_date: \"\",\n  date_of_birth: \"\",\n  gender: \"\",\n  username: \"\",\n  password: \"\",\n  confirm_password: \"\",\n  email: \"\",\n  agreed_to_terms: false,\n};\n\nexport function Registration(_props: RegistrationProps) {\n  const [values, setValues] = useState<RegistrationFormValues>(initialValues);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [submitting, setSubmitting] = useState(false);\n\n  const handleChange = (field: keyof RegistrationFormValues, value: string | boolean) => {\n    setValues((current) => ({ ...current, [field]: value }) as RegistrationFormValues);\n  };\n\n  const handleSubmit = async () => {\n    if (submitting) {\n      return;\n    }\n    setErrorMessage(null);\n    setSubmitting(true);\n    const result = await SubmitRegistration({ payload: values });\n    setSubmitting(false);\n    if (result.username) {\n      window.location.assign(\"/\");\n      return;\n    }\n    setErrorMessage(result.error ?? \"Registration failed. Please check the information you entered.\");\n  };\n\n  return (\n    <section data-ui-id=\"UI_000047\" className=\"flex min-h-screen flex-col bg-white\">\n      <RegistrationHeader />\n      <RegistrationPrimaryNavigation />\n      <main className=\"flex-1\">\n        <BreadcrumbRegion />\n        <RegistrationCard\n          values={values}\n          errorMessage={errorMessage}\n          submitting={submitting}\n          onChange={handleChange}\n          onSubmit={handleSubmit}\n        />\n      </main>\n      <RegistrationFooter />\n    </section>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/SubmitRegistration.ts","content":"export type RegistrationPayload = {\n  nationality: string;\n  name: string;\n  passport_number: string;\n  passport_expiration_date: string;\n  date_of_birth: string;\n  gender: string;\n  username: string;\n  password: string;\n  confirm_password: string;\n  email: string;\n  agreed_to_terms: boolean;\n};\n\nexport type SubmitRegistrationInput = { payload?: RegistrationPayload };\nexport type SubmitRegistrationOutput = { username?: string; error?: string };\n\nexport async function SubmitRegistration(\n  input: SubmitRegistrationInput,\n): Promise<SubmitRegistrationOutput> {\n  const payload: RegistrationPayload = input.payload ?? {\n    nationality: \"\",\n    name: \"\",\n    passport_number: \"\",\n    passport_expiration_date: \"\",\n    date_of_birth: \"\",\n    gender: \"\",\n    username: \"\",\n    password: \"\",\n    confirm_password: \"\",\n    email: \"\",\n    agreed_to_terms: false,\n  };\n\n  try {\n    const response = await fetch(\"/api/register\", {\n      method: \"POST\",\n      credentials: \"include\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Accept: \"application/json\",\n      },\n      body: JSON.stringify(payload),\n    });\n\n    const data = (await response.json().catch(() => ({}))) as {\n      username?: unknown;\n      error?: unknown;\n    };\n\n    if (typeof data.error === \"string\" && data.error.length > 0) {\n      return { error: data.error };\n    }\n\n    if (response.ok && typeof data.username === \"string\" && data.username.length > 0) {\n      return { username: data.username };\n    }\n\n    return { error: \"Registration failed. Please check the information you entered.\" };\n  } catch {\n    return { error: \"Registration failed. Please try again.\" };\n  }\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/ChangeNationality.ts","content":"export type ChangeNationalityInput = { \"value\": string; };\nexport type ChangeNationalityOutput = {  };\n\n/**\n * The selected nationality is held in the registration page state; the combobox\n * change itself never calls an API and performs no validation.\n */\nexport async function ChangeNationality(_input: ChangeNationalityInput): Promise<ChangeNationalityOutput> {\n  return {};\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/ChangeName.ts","content":"export type ChangeNameInput = { \"value\": string; };\nexport type ChangeNameOutput = {  };\n\n/**\n * The entered name is held in the registration page state; no API call is made\n * while typing and validation happens on submission.\n */\nexport async function ChangeName(_input: ChangeNameInput): Promise<ChangeNameOutput> {\n  return {};\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/ChangePassportNumber.ts","content":"export type ChangePassportNumberInput = { \"value\": string; };\nexport type ChangePassportNumberOutput = {  };\n\n/*
```ts
export async function ValidateRegistration(input) {
  if (input.agreed_to_terms !== true) return fail("You must agree to the Terms of Service and Privacy Policy.");
  const nonWhitespace = (input.name ?? "").replace(/\s/g, "").length;
  if (nonWhitespace < 2 || nonWhitespace > 100) return fail("Name must contain between 2 and 100 non-whitespace characters.");
  if (!/^[A-Za-z0-9-]{6,30}$/.test(input.passport_number ?? "")) return fail("Passport number must be 6-30 letters, digits or hyphens.");
  const today = startOfToday();
  const dob = parseDate(input.date_of_birth);
  if (!dob || dob >= today) return fail("Date of birth must be earlier than today.");
  const exp = parseDate(input.passport_expiration_date);
  if (!exp || exp <= today) return fail("Passport expiration date must be later than today.");
  if (input.gender !== "Male" && input.gender !== "Female") return fail("Gender must be Male or Female.");
  if (!/^[A-Za-z0-9_-]{3,32}$/.test(input.username ?? "")) return fail("Username must be 3-32 letters, digits, hyphens or underscores.");
  if (!isValidEmail(input.email)) return fail("Email must be a valid address of at most 254 characters.");
  if (!isStrongPassword(input.password)) return fail("Password must be 12-128 characters including uppercase, lowercase, digit and special character.");
  if (input.password !== input.confirm_password) return fail("Passwords must match.");
  const uniqueness = await CheckAccountUniqueness({ username: input.username, email: input.email });
  if (uniqueness.username_taken) return fail("That username is already taken.");
  if (uniqueness.email_taken) return fail("That email is already registered.");
  return { valid: true, error: null };
}
```


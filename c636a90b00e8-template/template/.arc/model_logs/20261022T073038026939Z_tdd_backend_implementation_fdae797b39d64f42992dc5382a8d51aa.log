import { randomUUID } from "node:crypto";
import { scryptSync, randomBytes, timingSafeEqual } from "node:crypto";
import { getDatabase } from "../../../db/client.js";
import { ValidateRegistration } from "./ValidateRegistration.js";

export async function CreateTravelerAccount(input) {
  const validation = await ValidateRegistration(input);
  if (!validation.valid) return { username: null, session_id: null, error: validation.error };
  const accountId = randomUUID();
  const sessionId = randomUUID();
  const salt = randomBytes(16).toString("hex");
  const hash = scryptSync(input.password, salt, 64).toString("hex");
  const passwordHash = `scrypt$${salt}$${hash}`;
  const db = getDatabase();
  try {
    const insert = db.transaction(() => {
      db.prepare(`INSERT INTO "user_account" ("id","nationality","name","passport_number","passport_expiration_date","date_of_birth","gender","username","email","password") VALUES (?,?,?,?,?,?,?,?,?,?)`).run(accountId, input.nationality, input.name, input.passport_number, input.passport_expiration_date, input.date_of_birth, input.gender, input.username, input.email, passwordHash);
      db.prepare(`INSERT INTO "session" ("id","user_account_id") VALUES (?,?)`).run(sessionId, accountId);
    });
    insert();
    return { username: input.username, session_id: sessionId, error: null };
  } catch (error) {
    return { username: null, session_id: null, error: error instanceof Error ? error.message : "Registration failed" };
  }
}

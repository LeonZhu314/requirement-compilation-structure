    "tests/unit/req-1-6aa2db3c.test.ts": {
      "content": "import { describe, it, expect } from \"vitest\";\nimport { randomUUID } from \"node:crypto\";\nimport { ResolveActiveSession } from \"../../backend/src/features/train-ticket-booking-demo/services/ResolveActiveSession.js\";\nimport { RevokeSession } from \"../../backend/src/features/train-ticket-booking-demo/services/RevokeSession.js\";\nimport { FindSessionAccountById } from \"../../backend/src/features/train-ticket-booking-demo/repositories/FindSessionAccountById.js\";\nimport { DeleteSessionById } from \"../../backend/src/features/train-ticket-booking-demo/repositories/DeleteSessionById.js\";\n\ndescribe(\"REQ-1 ResolveActiveSession\", () => {\n  it(\"treats an absent session id as unauthenticated\", async () => {\n    await expect(ResolveActiveSession({})).resolves.toEqual({ authenticated: false, username: null });\n  });\n\n  it(\"treats a null session id as unauthenticated\", async () => {\n    await expect(ResolveActiveSession({ session_id: null })).resolves.toEqual({ authenticated: false, username: null });\n  });\n\n  it(\"treats an unknown session id as unauthenticated\", async () => {\n    await expect(ResolveActiveSession({ session_id: randomUUID() })).resolves.toEqual({ authenticated: false, username: null });\n  });\n});\n\ndescribe(\"REQ-1 FindSessionAccountById\", () => {\n  it(\"reports not found for an unknown session id\", async () => {\n    await expect(FindSessionAccountById({ session_id: randomUUID() })).resolves.toEqual({ found: false, username: null });\n  });\n});\n\ndescribe(\"REQ-1 RevokeSession sign out\", () => {\n  it(\"succeeds without a session id\", async () => {\n    await expect(RevokeSession({})).resolves.toEqual({});\n  });\n\n  it(\"succeeds with a null session id\", async () => {\n    await expect(RevokeSession({ session_id: null })).resolves.toEqual({});\n  });\n\n  it(\"succeeds with an unknown session id\", async () => {\n    await expect(RevokeSession({ session_id: randomUUID() })).resolves.toEqual({});\n  });\n});\n\ndescribe(\"REQ-1 DeleteSessionById\", () => {\n  it(\"succeeds whether or not the session row exists\", async () => {\n    await expect(DeleteSessionById({ session_id: randomUUID() })).resolves.toEqual({});\n  });\n});\n",
      "exists": true,
      "context_location": "read_only_files"
    },
    "backend/src/features/train-ticket-booking-demo/controllers/RegisterAccount.ts": {
      "content": "import { CreateTravelerAccount } from \"../services/CreateTravelerAccount.js\";\n\nexport type RegisterAccountInput = { \"nationality\": string; \"name\": string; \"passport_number\": string; \"passport_expiration_date\": string; \"date_of_birth\": string; \"gender\": (\"Male\" | \"Female\"); \"username\": string; \"password\": string; \"confirm_password\": string; \"email\": string; \"agreed_to_terms\": boolean; };\nexport type RegisterAccountOutput = { \"username\"?: string; \"session_id\"?: string; \"error\"?: string; };\n\nexport async function RegisterAccount(input: RegisterAccountInput): Promise<RegisterAccountOutput> {\n  const result = await CreateTravelerAccount(input);\n  if (result.error || !result.username || !result.session_id) {\n    return { error: result.error ?? \"Registration failed.\" };\n  }\n  return { username: result.username, session_id: result.session_id };\n}\n",
      "exists": true,
      "context_location": "read_only_files"
    },
    "backend/src/features/train-ticket-booking-demo/repositories/FindAccountByUsernameOrEmail.ts": {
      "content": "import { getDatabase } from \"../../../db/client.js\";\n\nexport type FindAccountByUsernameOrEmailInput = { \"username\": string; \"email\": string; };\nexport type FindAccountByUsernameOrEmailOutput = { \"username_taken\": boolean; \"email_taken\": boolean; };\n\nexport async function FindAccountByUsernameOrEmail(input: FindAccountByUsernameOrEmailInput): Promise<FindAccountByUsernameOrEmailOutput> {\n  const database = getDatabase();\n  const usernameMatch = database\n    .prepare('SELECT 1 AS \"present\" FROM \"user_account\" WHERE \"username\" = ? LIMIT 1')\n    .get(input.username) as { present: number } | undefined;\n  const emailMatch = database\n    .prepare('SELECT 1 AS \"present\" FROM \"user_account\" WHERE \"email\" = ? COLLATE NOCASE LIMIT 1')\n    .get(input.email) as { present: number } | undefined;\n\n  return { username_taken: Boolean(usernameMatch), email_taken: Boolean(emailMatch) };\n}\n",
      "exists": true,
      "context_location": "read_only_files"
    },
    "backend/src/features/train-ticket-booking-demo/repositories/InsertSession.ts": {
      "content": "import { getDatabase } from \"../../../db/client.js\";\n\nexport type InsertSessionInput = { \"session_id\": string; \"account_id\": string; };\nexport type InsertSessionOutput = { \"session_id\": string; };\n\nexport async function InsertSession(input: InsertSessionInput): Promise<InsertSessionOutput> {\n  getDatabase()\n    .prepare('INSERT INTO \"session\" (\"id\", \"user_account_id\") VALUES (?, ?)')\n    .run(input.session_id, input.account_id);\n  return { session_id: input.session_id };\n}\n",

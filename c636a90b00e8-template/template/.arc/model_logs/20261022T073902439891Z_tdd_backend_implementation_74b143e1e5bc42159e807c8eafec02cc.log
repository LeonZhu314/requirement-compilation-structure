{"request_files":[],"blocked_reason":"","release_files":[],"edits":[{"file":"backend/src/features/train-ticket-booking-demo/repositories/InsertUserAccount.ts","content":"import type Database from \"better-sqlite3\";\nimport { getDatabase } from \"../../../db/client.js\";\n\nexport type InsertUserAccountInput = { \"account_id\": string; \"nationality\": string; \"name\": string; \"passport_number\": string; \"passport_expiration_date\": string; \"date_of_birth\": string; \"gender\": (\"Male\" | \"Female\"); \"username\": string; \"email\": string; \"password_hash\": string; };\nexport type InsertUserAccountOutput = { \"account_id\": string; };\n\nconst insertUserAccountSql =\n  'INSERT INTO \"user_account\" (\"id\", \"nationality\", \"name\", \"passport_number\", \"passport_expiration_date\", \"date_of_birth\", \"gender\", \"username\", \"email\", \"password\") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)';\n\n/** Synchronous insert used inside the caller's transaction so account and session stay atomic. */\nexport function insertUserAccountRow(database: Database.Database, input: InsertUserAccountInput): void {\n  database\n    .prepare(insertUserAccountSql)\n    .run(\n      input.account_id,\n      input.nationality,\n      input.name,\n      input.passport_number,\n      input.passport_expiration_date,\n      input.date_of_birth,\n      input.gender,\n      input.username,\n      input.email,\n      input.password_hash\n    );\n}\n\nexport async function InsertUserAccount(input: InsertUserAccountInput): Promise<InsertUserAccountOutput> {\n  insertUserAccountRow(getDatabase(), input);\n  return { account_id: input.account_id };\n}\n"},{"file":"backend/src/features/train-ticket-booking-demo/repositories/InsertSession.ts","content":"import type Database from \"better-sqlite3\";\nimport { getDatabase } from \"../../../db/client.js\";\n\nexport type InsertSessionInput = { \"session_id\": string; \"account_id\": string; };\nexport type InsertSessionOutput = { \"session_id\": string; };\n\nconst insertSessionSql = 'INSERT INTO \"session\" (\"id\", \"user_account_id\") VALUES (?, ?)';\n\n/** Synchronous insert used inside the caller's transaction so account and session stay atomic. */\nexport function insertSessionRow(database: Database.Database, input: InsertSessionInput): void {\n  database.prepare(insertSessionSql).run(input.session_id, input.account_id);\n}\n\nexport async function InsertSession(input: InsertSessionInput): Promise<InsertSessionOutput> {\n  insertSessionRow(getDatabase(), input);\n  return { session_id: input.session_id };\n}\n"},{"file":"backend/src/features/train-ticket-booking-demo/services/CreateTravelerAccount.ts","content":"import { randomBytes, randomUUID, scryptSync } from \"node:crypto\";\nimport { getDatabase } from \"../../../db/client.js\";\nimport { insertSessionRow } from \"../repositories/InsertSession.js\";\nimport { insertUserAccountRow } from \"../repositories/InsertUserAccount.js\";\nimport { ValidateRegistration } from \"./ValidateRegistration.js\";\n\nexport type CreateTravelerAccountInput = { \"nationality\": string; \"name\": string; \"passport_number\": string; \"passport_expiration_date\": string; \"date_of_birth\": string; \"gender\": (\"Male\" | \"Female\"); \"username\": string; \"password\": string; \"confirm_password\": string; \"email\": string; \"agreed_to_terms\": boolean; };\nexport type CreateTravelerAccountOutput = { \"username\": (string | null); \"session_id\": (string | null); \"error\": (string | null); };\n\nfunction hashPassword(plainPassword: string): string {\n  const salt = randomBytes(16).toString(\"hex\");\n  const derived = scryptSync(plainPassword, salt, 64).toString(\"hex\");\n  return `scrypt$${salt}$${derived}`;\n}\n\nexport async function CreateTravelerAccount(input: CreateTravelerAccountInput): Promise<CreateTravelerAccountOutput> {\n  const validation = await ValidateRegistration(input);\n  if (!validation.valid) {\n    return { username: null, session_id: null, error: validation.error ?? \"Registration failed.\" };\n  }\n\n  const accountId = randomUUID();\n  const sessionId = randomUUID();\n  const passwordHash = hashPassword(input.password);\n\n  try {\n    const database = getDatabase();\n    database.transaction(() => {\n      insertUserAccountRow(database, {\n        account_id: accountId,\n        nationality: input.nationality,\n        name: input.name,\n        passport_number: input.passport_number,\n        passport_expiration_date: input.passport_expiration_date,\n        date_of_birth: input.date_of_birth,\n        gender: input.gender,\n        username: input.username,\n        email: input.email,\n        password_hash: passwordHash,\n      });\n      insertSessionRow(database, { session_id: sessionId, account_id: accountId });\n    })();\n  } catch (error) {\n    const message = error instanceof Error ? error.message : \"Registration failed.\";\n    return { username: null, session_id: null, error: message };\n  }\n\n  return { username: input.username, session_id: sessionId, error: null };\n}\n"}]}


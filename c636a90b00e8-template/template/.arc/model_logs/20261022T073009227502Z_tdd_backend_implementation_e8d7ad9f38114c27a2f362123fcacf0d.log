{"type": "object", "additionalProperties": false, "properties": {"request_files": {"type": "array", "items": {"type": "string"}}, "release_files": {"type": "array", "items": {"type": "string"}}, "edits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"file": {"type": "string"}, "content": {"type": "string"}}, "required": ["file", "content"]}}, "blocked_reason": {"type": "string"}}, "required": ["request_files", "release_files", "edits", "blocked_reason"]}

\"w-full border-t border-gray-200 bg-[#f5f5f5] py-7 text-center text-[12px] leading-6 text-gray-500\">\n      <div className=\"mx-auto w-full max-w-[1200px] px-4\">\n        <p data-ui-id=\"UI_000043\">\n          COPYRIGHT©2008-2025 CHINA ACADEMY OF RAILWAY SCIENCES CORPORATION LIMITED, ALL RIGHTS RESERVED.\n        </p>\n        <p data-ui-id=\"UI_000044\">京公网安备 11010802038392号 | 京ICP备05020493号-4 | ICP证：京B2-20202537.</p>\n        <div className=\"mt-1 flex flex-wrap items-center justify-center gap-x-2 gap-y-1\">\n          <a data-ui-id=\"UI_000045\" href=\"#\" className=\"transition-colors hover:text-[#2f74c0]\">\n            Privacy Policy\n          </a>\n          <span aria-hidden=\"true\" className=\"text-gray-300\">|</span>\n          <a data-ui-id=\"UI_000046\" href=\"#\" className=\"transition-colors hover:text-[#2f74c0]\">\n            Cookie Statement\n          </a>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/pages/Home.tsx","content":"import { useEffect, useState } from \"react\";\nimport { Header } from \"../components/Header\";\nimport { PrimaryNavigation } from \"../components/PrimaryNavigation\";\nimport { HeroBanner } from \"../components/HeroBanner\";\nimport { QuickGuideSection } from \"../components/QuickGuideSection\";\nimport { Footer } from \"../components/Footer\";\nimport { LoadSessionState, type SessionState } from \"../handlers/LoadSessionState\";\nimport { SignOutAccount } from \"../handlers/SignOutAccount\";\n\nexport type HomeState = { \"session_state\": SessionState };\nexport type HomeProps = {};\n\nexport function Home(_props: HomeProps) {\n  const [session, setSession] = useState<SessionState>({ authenticated: false, username: null });\n\n  useEffect(() => {\n    let cancelled = false;\n    LoadSessionState({}).then((result) => {\n      if (!cancelled) {\n        setSession(result.session_state);\n      }\n    });\n    return () => {\n      cancelled = true;\n    };\n  }, []);\n\n  const handleSignOut = async () => {\n    const result = await SignOutAccount({});\n    if (result.success) {\n      setSession({ authenticated: false, username: null });\n    }\n  };\n\n  return (\n    <section data-ui-id=\"UI_000001\" className=\"min-h-screen bg-white\">\n      <Header session={session} onSignOut={handleSignOut} />\n      <PrimaryNavigation />\n      <main>\n        <HeroBanner />\n        <QuickGuideSection />\n      </main>\n      <Footer />\n    </section>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/LoadSessionState.ts","content":"export type LoadSessionStateInput = {  };\nexport type SessionState = { authenticated: boolean; username: string | null };\nexport type LoadSessionStateOutput = { session_state: SessionState };\n\nexport async function LoadSessionState(_input: LoadSessionStateInput): Promise<LoadSessionStateOutput> {\n  try {\n    const response = await fetch(\"/api/session\", {\n      method: \"GET\",\n      credentials: \"include\",\n      headers: { Accept: \"application/json\" },\n    });\n    if (!response.ok) {\n      throw new Error(`Request failed with ${response.status}`);\n    }\n    const data = (await response.json()) as { authenticated?: unknown; username?: unknown };\n    return {\n      session_state: {\n        authenticated: Boolean(data.authenticated),\n        username: typeof data.username === \"string\" ? data.username : null,\n      },\n    };\n  } catch {\n    return { session_state: { authenticated: false, username: null } };\n  }\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/handlers/SignOutAccount.ts","content":"export type SignOutAccountInput = {  };\nexport type SignOutAccountOutput = { success: boolean };\n\nexport async function SignOutAccount(_input: SignOutAccountInput): Promise<SignOutAccountOutput> {\n  try {\n    const response = await fetch(\"/api/session\", {\n      method: \"DELETE\",\n      credentials: \"include\",\n     
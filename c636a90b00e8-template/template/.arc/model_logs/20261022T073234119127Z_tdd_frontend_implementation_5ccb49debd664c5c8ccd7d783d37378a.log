LoadSessionState:
```
export type LoadSessionStateInput = {};
export type SessionState = { authenticated: boolean; username: string | null };
export type LoadSessionStateOutput = { session_state: SessionState };
export async function LoadSessionState(_input: LoadSessionStateInput): Promise<LoadSessionStateOutput> {
 try {
  const response = await fetch("/api/session", { credentials: "include" });
  if (!response.ok) throw new Error...
  const data = await response.json();
  return { session_state: { authenticated: Boolean(data?.authenticated), username: typeof data?.username === "string" ? data.username : null } };
 } catch {
  return { session_state: { authenticated: false, username: null } };
 }
}
```
SignOutAccount:
```
export type SignOutAccountOutput = { success: boolean };
export async function SignOutAccount(...): Promise<...> {
 try { const response = await fetch("/api/session",{method:"DELETE",credentials:"include"}); return {success: response.ok}; } catch { return {success:false}; }
}
```

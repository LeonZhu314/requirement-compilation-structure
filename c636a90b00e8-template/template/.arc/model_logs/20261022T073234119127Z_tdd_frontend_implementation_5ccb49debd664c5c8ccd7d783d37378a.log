rea.tsx","content":"import type { SessionState } from \"../handlers/LoadSessionState\";\n\nexport type HeaderAccountAreaState = {  };\nexport type HeaderAccountAreaProps = {\n  session: SessionState;\n  onSignOut: () => void;\n};\n\nexport function HeaderAccountArea({ session, onSignOut }: HeaderAccountAreaProps) {\n  return (\n    <div data-ui-id=\"UI_000011\" className=\"flex items-center text-sm text-[#2f74c0]\">\n      {session.authenticated ? (\n        <div data-ui-id=\"UI_000015\" className=\"flex items-center gap-3\">\n          <span data-ui-id=\"UI_000016\" className=\"max-w-[180px] truncate text-gray-800\">\n            {session.username}\n          </span>\n          <a\n            data-ui-id=\"UI_000017\"\n            href=\"#\"\n            onClick={(event) => {\n              event.preventDefault();\n              onSignOut();\n            }}\n            className=\"font-medium transition-colors hover:text-[#c62430]\"\n          >\n            Sign out\n          </a>\n        </div>\n      ) : (\n        <div data-ui-id=\"UI_000012\" className=\"flex items-center gap-2\">\n          <a data-ui-id=\"UI_000013\" href=\"/register\" className=\"font-medium transition-colors hover:text-[#c62430]\">\n            Register\n          </a>\n          <span aria-hidden=\"true\" className=\"text-gray-300\">|</span>\n          <a data-ui-id=\"UI_000014\" href=\"/login\" className=\"font-medium transition-colors hover:text-[#c62430]\">\n            Login\n          </a>\n        </div>\n      )}\n    </div>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/Header.tsx","content":"import { BrandBlock } from \"./BrandBlock\";\nimport { HeaderUtilityNav } from \"./HeaderUtilityNav\";\nimport { HeaderAccountArea } from \"./HeaderAccountArea\";\nimport type { SessionState } from \"../handlers/LoadSessionState\";\n\nexport type HeaderState = {  };\nexport type HeaderProps = {\n  session: SessionState;\n  onSignOut: () => void;\n};\n\nexport function Header({ session, onSignOut }: HeaderProps) {\n  return (\n    <header data-ui-id=\"UI_000002\" className=\"border-b border-gray-200 bg-white\">\n      <div className=\"mx-auto flex w-full max-w-[1200px] flex-col gap-3 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between\">\n        <BrandBlock />\n        <div className=\"flex flex-wrap items-center gap-x-8 gap-y-2 lg:justify-end\">\n          <HeaderUtilityNav />\n          <HeaderAccountArea session={session} onSignOut={onSignOut} />\n        </div>\n      </div>\n    </header>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/PrimaryNavigation.tsx","content":"function ChevronDown() {\n  return (\n    <svg viewBox=\"0 0 12 12\" className=\"h-3 w-3\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"m2.5 4.25 3.5 3.5 3.5-3.5\" stroke=\"currentColor\" strokeWidth=\"1.3\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    </svg>\n  );\n}\n\nexport type PrimaryNavigationState = {  };\nexport type PrimaryNavigationProps = {};\n\nexport function PrimaryNavigation(_props: PrimaryNavigationProps) {\n  return (\n    <nav data-ui-id=\"UI_000018\" className=\"w-full bg-[#2f74c0] text-white\">\n      <div className=\"mx-auto flex w-full max-w-[1200px] items-stretch px-4 sm:px-6\">\n        <a data-ui-id=\"UI_000019\" href=\"/\" className=\"border-r border-white/25 px-7 py-3 text-sm font-medium transition-colors hover:bg-[#255f9e]\">\n          Home\n        </a>\n        <a data-ui-id=\"UI_000020\" href=\"#\" className=\"flex items-center gap-1.5 border-r border-white/25 px-7 py-3 text-sm font-medium transition-colors hover:bg-[#255f9e]\">\n          Booking\n          <ChevronDown />\n        </a>\n        <a data-ui-id=\"UI_000021\" href=\"#\" className=\"flex items-center gap-1.5 px-7 py-3 text-sm font-medium transition-colors hover:bg-[#255f9e]\">\n          Travel guides\n          <ChevronDown />\n        </a>\n      </div>\n    </nav>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/BannerIndicators.tsx","content":"export type BannerIndicatorsState = {  };\nexport type BannerIndicatorsProps = {};\n\nconst indicators = [\"Show banner 1\", \"Show banner 2\", \"Show banner 3\"];\n\nexport function BannerIndicators(_props: BannerIndicatorsProps) {\n  return (\n    <div data-ui-id=\"UI_000024\" className=\"absolute bottom-[9.5rem] left-6 z-10 flex items-center gap-3 md:left-16 lg:left-[calc((100%-1200px)/2+24px)]\">\n      {indicators.map((label, index) => (\n        <button\n          key={label}\n          type=\"button\"\n          aria-label={label}\n          aria-pressed={index === 0}\n          data-ui-id={index === 0 ? \"UI_000025\" : index === 1 ? \"UI_000026\" : \"UI_000027\"}\n          className={index === 0 ? \"h-2.5 w-2.5 rounded-full bg-white shadow-sm\" : \"h-2.5 w-2.5 rounded-full bg-white/40 transition-colors hover:bg-white/70\"}\n        />\n      ))}\n    </div>\n  );\n}\n"},{"file":"frontend/src/features/train-ticket-booking-demo/components/SearchPanel.tsx","content":"import { useState } from \"react\";\n\nfunction InfoIcon() {\n  return (\n    <svg viewBox=\"0 0 18 18\" className=\"mt-0.5 h-4 w-4 flex-none text-gray-400\" fill=\"none\" aria-hidden=\"true\">\n      <circle cx=\"9\" cy=\"9\" r=\"7\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n      <path d=\"M9 8v4M9 5.6v.2\" stroke=\"currentColor\" strokeWidth=\"1.6\" strokeLinecap=\"round\" />\n    </svg>\n  );\n}\n\nfunction PinIcon() {\n  return (\n    <svg viewBox=\"0 0 18 18\" className=\"h-4 w-4\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M9 16s5-4.6 5-9A5 5 0 0 0 4 7c0 4.4 5 9 5 9Z\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n      <circle cx=\"9\" cy=\"7\" r=\"1.7\" stroke=\"currentColor\" strokeWidth=\"1.4\" />\n    </svg>\n  );\n}\n\nfunction CalendarIcon() {\n  return (\n    <svg viewBox=\"0 0 18 18\" className=\"h-4 w-4\" fill=\"none\" aria-hidden=\"true\">\n      <rect x=\"3\" y=\"4.5\
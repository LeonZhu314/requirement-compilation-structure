## Backend API contracts

```json
{
  "api_contracts": [
    {
      "shared_reason": "",
      "path": "/api/register",
      "shared": false,
      "method": "POST",
      "payload": "{\"type\": \"object\", \"properties\": {\"nationality\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"Selected nationality, e.g. \\\"Vietnam\\\".\"}, \"name\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"Traveler full name as printed on the passport.\"}, \"passport_number\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"Passport number: 6-30 ASCII letters, digits or hyphens.\"}, \"passport_expiration_date\": {\"type\": \"string\", \"format\": \"date\", \"source\": \"body\", \"description\": \"Passport expiry date; must be later than the current date.\"}, \"date_of_birth\": {\"type\": \"string\", \"format\": \"date\", \"source\": \"body\", \"description\": \"Traveler date of birth; must be earlier than the current date.\"}, \"gender\": {\"type\": \"string\", \"enum\": [\"Male\", \"Female\"], \"source\": \"body\", \"description\": \"Selected gender radio option.\"}, \"username\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"3-32 ASCII letters, digits, hyphens or underscores; must be unique.\"}, \"password\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"12-128 characters including uppercase, lowercase, digit and special character.\"}, \"confirm_password\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"Must be identical to password.\"}, \"email\": {\"type\": \"string\", \"source\": \"body\", \"description\": \"Valid email address, at most 254 characters; unique regardless of letter case.\"}, \"agreed_to_terms\": {\"type\": \"boolean\", \"source\": \"body\", \"description\": \"True when the visitor checked the Terms of Service and Privacy Policy agreement checkbox.\"}}, \"required\": [\"nationality\", \"name\", \"passport_number\", \"passport_expiration_date\", \"date_of_birth\", \"gender\", \"username\", \"password\", \"confirm_password\", \"email\", \"agreed_to_terms\"], \"additionalProperties\": false}",
      "response": "{\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\", \"description\": \"Saved account username displayed as text in the header after automatic login.\"}, \"error\": {\"type\": \"string\", \"description\": \"Message describing the invalid or duplicate input; present only when no account was created.\"}}, \"required\": [], \"additionalProperties\": false}",
      "name": "RegisterAccount",
      "spec": "{any unauthenticated visitor may call; the body supplies nationality, name, passport_number, passport_expiration_date, date_of_birth, gender, username, password, confirm_password, email and agreed_to_terms, all of which are mandatory} validates the supplied values before any write: agreed_to_terms must be true; name must contain 2-100 non-whitespace characters; passport_number must consist of 6-30 ASCII letters, digits or hyphens; date_of_birth must be earlier than the current date read from the clock; passport_expiration_date must be later than the current date; username must be 3-32 ASCII letters, digits, hyphens or underscores; email must be syntactically valid and at most 254 characters; password must be 12-128 characters containing an uppercase letter, a lowercase letter, a digit and a special character; confirm_password must equal password; username must not already belong to an existing account and email must not already belong to an existing account under case-insensitive comparison. When every check passes, it persists a new user_account holding exactly these validated values (a locally hashed password derived from the supplied password is stored in place of the plain password, and a locally generated account identifier is assigned) and creates a new persisted session for that account identifier; it then sets the generated session identifier as the session cookie value on the Set-Cookie response header and responds with the saved username so the header can display it and offer Sign out. If any validation check fails or the username or email is already taken, it responds with an error description and creates no account and no session. {on success the new account and session exist, the session cookie is set, and username is returned; on failure no user_account row and no session row are created and no cookie is set} {rows of other accounts and sessions are left unchanged; the agreed_to_terms value itself is not persisted; no clear-text password is stored or returned}",
      "id": "API_000003",
      "kind": "API",
      "reqs": [
        "REQ-2"
      ],
      "callers": [],
      "callees": [
        "FUNC_000005"
      ]
    },
    {
      "shared_reason": "",
      "path": "/api/session",
      "shared": false,
      "method": "DELETE",
      "payload": "{\"type\": \"object\", \"properties\": {\"session_id\": {\"type\": \"string\", \"format\": \"uuid\", \"source\": \"header\", \"description\": \"Session identifier carried by the session cookie; extracted from the Cookie request header.\"}}, \"additionalProperties\": false, \"required\": []}",
      "response": "{\"type\": \"object\", \"properties\": {}, \"required\": [], \"additionalProperties\": false}",
      "name": "SignOut",
      "spec": "{invoked by an authenticated visitor clicking Sign out; session_id is read from the Cookie request header and may be absent or already unknown} deletes the persisted session identified by session_id and clears the session cookie carrier on the response by setting that cookie to an empty value with an expiry in the past, so the visitor returns to the unauthenticated state where the header again shows the Register and Login links {always responds with success, even when session_id is absent or unknown, and always clears the cookie} {no other session is affected; user_account rows, including the saved username, are preserved unchanged; no new session is created}",
      "id": "API_000002",
      "kind": "API",
      "reqs": [
        "REQ-1"
      ],
      "callers": [],
      "callees": [
        "FUNC_000002"
      ]
    },
    {
      "shared_reason": "",
      "path": "/api/session",
      "shared": false,
      "method": "GET",
      "payload": "{\"type\": \"object\", \"properties\": {\"session_id\": {\"type\": \"string\", \"format\": \"uuid\", \"source\": \"header\", \"description\": \"Session identifier carried by the session cookie; extracted from the Cookie request header. Absent for an anonymous visitor.\"}}, \"additionalProperties\": false, \"required\": []}",
      "response": "{\"type\": \"object\", \"properties\": {\"authenticated\": {\"type\": \"boolean\"}, \"username\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"description\": \"The saved account username rendered as text in the header after registration or login; null when no valid session is presented.\"}}, \"required\": [\"authenticated\", \"username\"], \"additionalProperties\": false}",
      "name": "GetCurrentSession",
      "spec": "{no authentication precondition; session_id may be absent, unknown or expired} reads the session identifier supplied via the Cookie header and passes it to the session/account lookup {when the session exists and resolves to a user_account, responds authenticated=true with that account's username so the page header can display the saved username and offer Sign out; when session_id is absent, unknown, expired or resolves to no account, responds authenticated=false with username null so the header shows the Register and Login links} {no writes; creates, modifies and clears no session or account data}",
      "id": "API_000001",
      "kind": "API",
      "reqs": [
        "REQ-1"
      ],
      "callers": [],
      "callees": [
        "FUNC_000001"
      ]
    }
  ]
}
